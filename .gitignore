build/
build-release/
sdkconfig
sdkconfig.old
managed_components/
dependencies.lock
*.o

# Host test binaries. run_tests.sh compiles them in place next to their sources
# and does not clean up, so they have to be ignored by pattern: naming them one
# at a time meant every suite added after the rule was written silently
# committed its executable. Eight of them were tracked -- macOS arm64, rebuilt
# by the script in a second, and useless on anyone else's machine.
test/host/test_*
!test/host/test_*.c

# Deliberately broken firmware for the rollback test -- never beside real releases.
*BROKEN*
testimages/
preview.html

# Development tree: the bench console, the desk tooling, serial captures and
# deliberately-broken test images. Not part of what ships, and not something a
# published repository should carry -- the console alone can rebind the module
# to any MAC, drop its camera link and clear its BLE bonds.
#
# It sits inside this directory rather than beside it so the build finds it at
# the same path either way: CMakeLists.txt adds it only if it is here, so a
# checkout without it builds a release image with no reference to it at all.
/dev/

# Built firmware and the sdkconfig snapshot that goes with it. A few MB per
# version, and git keeps every byte of it for ever. Binaries belong on GitHub
# Releases, attached to the tag they were built from: one download for the
# person who wants one, none for the person who wants the source.
# tools/release.sh writes all three here; they are just not committed.
releases/

# Front-end intermediates. web/.build/ is tsc output that tools/build_web.py
# inlines into the two committed pages, so it is a step on the way rather than
# a thing anything downstream reads. Node is a contributor-only dependency:
# neither the firmware build nor the Pages deploy touches either of these.
web/.build/
web/node_modules/

.DS_Store

# Bundled firmware for the browser flasher: build artifacts, not source, kept
# out of git like the release binaries. There are two of them and they are not
# interchangeable -- see dist/firmware/README.md for which goes where. The
# tool's "choose a .bin" option works without either.
dist/firmware/*.bin
build-ci/
